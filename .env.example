# ── LLM provider switch: "openai" or "groq" ─────────────────────────────────
# Flip LLM_PROVIDER to switch providers. Set the matching API key below.
LLM_PROVIDER=groq

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Groq (OpenAI-compatible, base_url handled automatically) ────────────────
GROQ_API_KEY=gsk-your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Model names (OPTIONAL — per-provider fallbacks apply when unset) ────────
# OpenAI defaults: gpt-5.4-mini / gpt-5.4-nano
# Groq defaults:   llama-3.3-70b-versatile / llama-3.1-8b-instant
MODEL_NAME=llama-3.3-70b-versatile
EVALUATION_MODEL_NAME=llama-3.1-8b-instant

DATABASE_URI=postgresql://talentos:talentos@postgres:5432/talentos

MCP_URL=
#If you are running locally on host system
# MCP_URL=http://127.0.0.1:8000/mcp

#If you are running the ai server in a docker container, and mcp server is running locally on host system
# MCP_URL=http://host.docker.internal:8000/mcp

#If you are running both ai-server & mcp server in a docker container on a same docker network
# MCP_URL=http://<mcp-server-container-name>:8000/mcp
