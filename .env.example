# ── LLM provider switch: "openai" or "groq" ─────────────────────────────────
# Flip LLM_PROVIDER to switch providers. Set the matching API key below.
LLM_PROVIDER=groq

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Groq (OpenAI-compatible, base_url handled automatically) ────────────────
GROQ_API_KEY=gsk-your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Model names (OPTIONAL — per-provider fallbacks apply when unset) ────────
# OpenAI defaults: gpt-5.4-mini / gpt-5.4-nano
# Groq defaults:   openai/gpt-oss-120b / openai/gpt-oss-20b
MODEL_NAME=openai/gpt-oss-120b
EVALUATION_MODEL_NAME=openai/gpt-oss-20b

DATABASE_URI=postgresql://talentos:talentos@postgres:5432/talentos

# ── OpenBao (OPTIONAL — secrets manager) ─────────────────────────────────────
# When BAO_ADDR is set, the app reads OPENAI_API_KEY / GROQ_API_KEY /
# DATABASE_URI from OpenBao (secret/data/ai/*) and OVERRIDES these env values.
# Used in production compose; leave unset for plain local dev.
# For local dev against the server-hosted OpenBao (no secrets in this file,
# no SSH — fetch your token once, see talentOS_Infra/docs/openbao-ops.md):
#   curl -u "$BAO_TOKEN_USER:$BAO_TOKEN_PASS" \
#     https://talentos.webknot-dev.in/bao-token/ai.token > ~/.talentos/ai.token
# BAO_ADDR=https://talentos.webknot-dev.in
# BAO_TOKEN_FILE=/path/to/home/.talentos/ai.token
# BAO_REQUIRED=true
# For a local OpenBao only:
# BAO_ADDR=http://127.0.0.1:8200
# BAO_TOKEN_FILE=/shared/ai.token
# BAO_REQUIRED=false   # set true to crash at startup if a secret is missing

MCP_URL=
#If you are running locally on host system
# MCP_URL=http://127.0.0.1:8000/mcp

#If you are running the ai server in a docker container, and mcp server is running locally on host system
# MCP_URL=http://host.docker.internal:8000/mcp

#If you are running both ai-server & mcp server in a docker container on a same docker network
# MCP_URL=http://<mcp-server-container-name>:8000/mcp
