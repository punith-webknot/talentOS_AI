OPENAI_API_KEY=sk-your-openai-key
MODEL_NAME=gpt-4o-mini
MCP_URL=http://mcp:8000/mcp
DATABASE_URI=postgresql://talentos:talentos@postgres:5432/talentos
LOG_LEVEL=INFO

# Gmail OAuth client (credentials.json fields)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_PROJECT_ID=your-gcp-project-id
GMAIL_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GMAIL_REDIRECT_URI=http://localhost

# MCP server (optional; used when running the recruitment MCP service)
TALENTOS_API_BASE_URL=http://host.docker.internal:3000
TALENTOS_API_TIMEOUT=30
